# Case.dev SDK (required for LLM-based PII detection and OCR)
CASEDEV_API_KEY=sk_case_...
CASEDEV_API_URL=https://api.case.dev

# Vercel Blob (required for PDF/DOCX/Image OCR processing)
# Auto-provided when Blob store is connected on Vercel
# For local development with OCR, copy from Vercel dashboard
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Database (Neon PostgreSQL) - optional for demo
# DATABASE_URL=

# Authentication (Better Auth) - optional for demo
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
